{
  "name": "@package/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Nucle-x UI",
  "author": "Trandx-code <trandxcode@gmail.com>",
  "module": "./dist/lib/index.js",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/lib/style.css",
  "files": [
    "dist/lib",
    "dist/types"
  ],
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./style.css": "./dist/lib/index.css"
  },
  "scripts": {
    "types": "vue-tsc",
    "types:watch": "vue-tsc --watch",
    "build:watch": "vite build --watch",
    "dev": "vite",
    "preview": "vite preview",
    "build": "vue-tsc && vite build && npm run cp && npm run mv-pkg-json",
    "cp": "find ./ -maxdepth 1 -type f \\( -name 'pub.*.json' -o -name 'README.md' \\) -exec cp {} ./dist \\; ",
    "mv-pkg-json": "cd ./dist && mv pub.package.json package.json"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@package/tailwind-config": "workspace:*",
    "@package/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.0.7",
    "@trandx/native": "workspace:*",
    "@trandx/vue-cropper": "workspace:*",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "knip": "^5.44.4",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vue-tsc": "^2.2.2"
  }
}
