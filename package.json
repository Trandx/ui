{
  "name": "@package/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Nucle-x UI",
  "author": "Trandx-code <trandxcode@gmail.com>",
  "module": "./dist/lib/index.js",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/lib/style.css",
  "files": [
    "dist/lib",
    "dist/types"
  ],
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./style.css": "./dist/lib/index.css"
  },
  "scripts": {
    "build:watch": "vite build --watch",
    "dev": "vite",
    "preview": "vite preview",
    "cp": "find ./ -maxdepth 1 -type f \\( -name 'pub.*.json' -o -name 'README.md' \\) -exec cp {} ./dist \\; ",
    "mv-pkg-json": "cd ./dist && mv pub.package.json package.json",
    "build": "run-p type-check \"build-only {@}\" -- && npm run cp && npm run mv-pkg-json",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "knip": "knip"
  },
  "dependencies": {
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@package/native": "workspace:*",
    "@package/tailwind-config": "workspace:*",
    "@package/tsconfig": "workspace:*",
    "@package/vue-cropper": "workspace:*",
    "@tailwindcss/vite": "^4.1.13",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.18.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/eslint-plugin": "1.1.31",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^9.33.0",
    "jiti": "^2.5.1",
    "jsdom": "^26.1.0",
    "knip": "^5.63.1",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.7.3",
    "vite": "^6.3.6",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vue-tsc": "^2.2.12"
  }
}
